# Copy to .env for local development. Every value here is optional: the MCP server and the
# dashboard both run with no configuration at all, because Open-Meteo and the National Weather
# Service need no credentials.
#
# On Databricks Apps these come from app.yaml instead. Never put a real secret in this file,
# and never commit a filled-in .env.

# The National Weather Service asks callers to identify themselves in the User-Agent header and
# blocks anonymous traffic. Put a real address here before you deploy.
NWS_CONTACT_EMAIL=you@example.com

# Optional: read the contact address from a Databricks secret instead of the line above, if you
# would rather keep the address out of the repo. Both must be set for this path to be used.
# NWS_CONTACT_SECRET_SCOPE=database
# NWS_CONTACT_SECRET_KEY=nws-contact-email

# Name sent alongside the contact address in the User-Agent header.
APP_NAME=weather-mcp-server

# Optional: the Lakebase query log that fills the dashboard's recent-queries panel. Leave both
# unset and logging quietly turns itself off. Locally, set LAKEBASE_URL directly; on Databricks,
# the two secret variables in app.yaml point at the stored connection string.
# LAKEBASE_URL=postgresql://<role>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=lakebase-url

# Ports. Databricks Apps sets DATABRICKS_APP_PORT at runtime, so these only matter locally.
# PORT=8000
